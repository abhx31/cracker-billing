# Neon connection string (Dashboard -> Connect -> pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Public address of the deployed app (no trailing slash). Bills sent on WhatsApp
# include a link to the PDF at this address. Not needed on Vercel (auto-detected).
APP_URL=""

# Shown at the top of every bill / WhatsApp message
SHOP_NAME="Sri Lakshmi Crackers"

# Prepended to 10-digit numbers entered without a country code
WHATSAPP_DEFAULT_COUNTRY_CODE="91"

# --- Optional: automatic sending via Meta WhatsApp Cloud API ---
# Leave these empty to use the free click-to-send (wa.me) link instead.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Approved template with 3 body variables: {{1}} customer name, {{2}} bill no, {{3}} total.
# Required to message customers who haven't messaged you in the last 24h.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en"
# Graph API version shown in your Meta app dashboard (e.g. v23.0). Old versions get retired.
WHATSAPP_API_VERSION=""
